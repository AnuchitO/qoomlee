direction: down

title: |md
  # Qoomlee — C4 Level 3: Component Diagram
  *Booking Service (Java/Kotlin) + Payment Service (Golang) + Infrastructure internals*
|

# ── Infrastructure Components ───────────────────────────────────────────────────────────

monitoring_svc: Monitoring & Observability {
  shape: rectangle
  style.fill: "#059669"
  style.font-color: "#FFFFFF"
  style.stroke: "#047857"
  style.stroke-width: 2
  style.border-radius: 8
  tooltip: "Prometheus + Grafana + Jaeger — Metrics collection, visualization and distributed tracing across all services. Implements health checks and alerting."

  prometheus: Prometheus {
    shape: rectangle
    style.fill: "#059669"
    style.font-color: "#FFFFFF"
    style.border-radius: 4
    tooltip: "Metrics collection and storage"
  }

  grafana: Grafana {
    shape: rectangle
    style.fill: "#059669"
    style.font-color: "#FFFFFF"
    style.border-radius: 4
    tooltip: "Visualization and dashboards"
  }

  jaeger: Jaeger {
    shape: rectangle
    style.fill: "#059669"
    style.font-color: "#FFFFFF"
    style.border-radius: 4
    tooltip: "Distributed tracing"
  }
}

secrets_svc: Secrets Management {
  shape: rectangle
  style.fill: "#7C3AED"
  style.font-color: "#FFFFFF"
  style.stroke: "#6D28D9"
  style.stroke-width: 2
  style.border-radius: 8
  tooltip: "HashiCorp Vault — Secure storage and retrieval of API keys, database passwords, and other sensitive configuration. Automatic rotation capabilities."

  vault_server: Vault Server {
    shape: rectangle
    style.fill: "#7C3AED"
    style.font-color: "#FFFFFF"
    style.border-radius: 4
    tooltip: "Vault server for secrets management"
  }

  vault_agent: Vault Agent {
    shape: rectangle
    style.fill: "#7C3AED"
    style.font-color: "#FFFFFF"
    style.border-radius: 4
    tooltip: "Sidecar agent for secret retrieval"
  }
}

api_gw: API Gateway {
  shape: rectangle
  style.fill: "#4B5563"
  style.font-color: "#FFFFFF"
  style.border-radius: 6
}

# ── Booking Service ───────────────────────────────────────────────────────────

booking: Booking Service (Java / Kotlin) {
  style.fill: "#EBF2FA"
  style.stroke: "#1A3557"
  style.stroke-width: 2
  style.border-radius: 10

  flight_search: FlightSearchHandler {
    shape: rectangle
    style.fill: "#1A3557"
    style.font-color: "#FFFFFF"
    style.border-radius: 4
    tooltip: "Handles GET /flights/search — queries Flight Service via REST, applies seat inventory filter, returns available flights with fare classes"
  }

  pnr_manager: PNRManager {
    shape: rectangle
    style.fill: "#1A3557"
    style.font-color: "#FFFFFF"
    style.border-radius: 4
    tooltip: "Core domain component — generates IATA-format PNR (6-char alphanumeric), manages PNR state machine: PENDING→CONFIRMED→CHECKED_IN→BOARDED→CANCELLED"
  }

  seat_inventory: SeatInventoryService {
    shape: rectangle
    style.fill: "#1A3557"
    style.font-color: "#FFFFFF"
    style.border-radius: 4
    tooltip: "Manages seat availability per flight per fare class. Creates seat lock in Redis (8-min TTL). Converts lock to permanent assignment on payment confirmation."
  }

  fare_engine: FareRulesEngine {
    shape: rectangle
    style.fill: "#1A3557"
    style.font-color: "#FFFFFF"
    style.border-radius: 4
    tooltip: "Applies modification fees, cancellation refund policy, fare class rules. Reads fare_rules table. Returns computed fee amounts."
  }

  booking_repo: BookingRepository {
    shape: rectangle
    style.fill: "#2E6DA4"
    style.font-color: "#FFFFFF"
    style.border-radius: 4
    tooltip: "JPA/Hibernate repository — CRUD on bookings, passengers, seat_inventory tables. Handles optimistic locking to prevent double-booking."
  }

  event_publisher: DomainEventPublisher {
    shape: rectangle
    style.fill: "#374151"
    style.font-color: "#FFFFFF"
    style.border-radius: 4
    tooltip: "Publishes domain events to Redis Streams: booking.confirmed, booking.cancelled, booking.modified — consumed by Notification Service and Payment Service"
  }

  state_machine: BookingStateMachine {
    shape: rectangle
    style.fill: "#1A3557"
    style.font-color: "#FFFFFF"
    style.border-radius: 4
    tooltip: "Spring State Machine — enforces valid transitions: PENDING→CONFIRMED (on payment), CONFIRMED→CHECKED_IN (on check-in), CONFIRMED→CANCELLED (on cancel). Rejects invalid transitions."
  }

  circuit_breaker: Circuit Breaker {
    shape: rectangle
    style.fill: "#1A3557"
    style.font-color: "#FFFFFF"
    style.border-radius: 4
    tooltip: "Circuit breaker pattern implementation for external service calls"
  }
}

# ── Payment Service ───────────────────────────────────────────────────────────

payment: Payment Service (Golang) {
  style.fill: "#FFF7ED"
  style.stroke: "#D97706"
  style.stroke-width: 2
  style.border-radius: 10

  charge_handler: ChargeHandler {
    shape: rectangle
    style.fill: "#92540A"
    style.font-color: "#FFFFFF"
    style.border-radius: 4
    tooltip: "POST /payments/charge — receives Omise token, calls Omise Charge API, records transaction. Returns charge ID and status."
  }

  qr_handler: PromptPayQRHandler {
    shape: rectangle
    style.fill: "#92540A"
    style.font-color: "#FFFFFF"
    style.border-radius: 4
    tooltip: "POST /payments/promptpay — calls Omise PromptPay API, receives QR payload, stores pending transaction. QR expires in 10 minutes."
  }

  webhook_handler: OmiseWebhookHandler {
    shape: rectangle
    style.fill: "#92540A"
    style.font-color: "#FFFFFF"
    style.border-radius: 4
    tooltip: "POST /webhooks/omise — validates Omise HMAC signature, processes payment.capture.success / payment.fail events, triggers booking confirmation via REST call to Booking Service."
  }

  refund_handler: RefundHandler {
    shape: rectangle
    style.fill: "#92540A"
    style.font-color: "#FFFFFF"
    style.border-radius: 4
    tooltip: "POST /payments/refund — calls Omise Refund API for card payments. Flags PromptPay refunds for manual bank transfer. Updates refunds table."
  }

  reconciler: ReconciliationJob {
    shape: rectangle
    style.fill: "#374151"
    style.font-color: "#FFFFFF"
    style.border-radius: 4
    tooltip: "Cron job (daily 01:00 ICT) — aggregates transactions by payment method, computes net revenue, flags mismatches vs Omise dashboard, generates reconciliation report."
  }

  payment_repo: PaymentRepository {
    shape: rectangle
    style.fill: "#D97706"
    style.font-color: "#FFFFFF"
    style.border-radius: 4
    tooltip: "PostgreSQL CRUD on payments, transactions, refunds tables. No raw card data stored — only Omise charge IDs and masked card last-4."
  }

  circuit_breaker: Circuit Breaker {
    shape: rectangle
    style.fill: "#92540A"
    style.font-color: "#FFFFFF"
    style.border-radius: 4
    tooltip: "Circuit breaker for external payment service calls"
  }

  retry_mechanism: Retry Handler {
    shape: rectangle
    style.fill: "#92540A"
    style.font-color: "#FFFFFF"
    style.border-radius: 4
    tooltip: "Retry mechanism for failed external service calls"
  }
}

