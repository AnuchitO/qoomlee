identity -> secrets_svc.vault_agent: "Retrieve service\nsecrets [Vault API]" {style.stroke: "#7C3AED"; style.stroke-dash: 3}
notification -> secrets_svc.vault_agent: "Retrieve provider\nAPI keys [Vault API]" {style.stroke: "#7C3AED"; style.stroke-dash: 3}

booking -> monitoring_svc.prometheus: "Send metrics\n[Prometheus endpoint]" {style.stroke: "#059669"; style.stroke-dash: 3}
payment -> monitoring_svc.prometheus: "Send metrics\n[Prometheus endpoint]" {style.stroke: "#059669"; style.stroke-dash: 3}
checkin -> monitoring_svc.prometheus: "Send metrics\n[Prometheus endpoint]" {style.stroke: "#059669"; style.stroke-dash: 3}
flight -> monitoring_svc.prometheus: "Send metrics\n[Prometheus endpoint]" {style.stroke: "#059669"; style.stroke-dash: 3}
passenger -> monitoring_svc.prometheus: "Send metrics\n[Prometheus endpoint]" {style.stroke: "#059669"; style.stroke-dash: 3}
identity -> monitoring_svc.prometheus: "Send metrics\n[Prometheus endpoint]" {style.stroke: "#059669"; style.stroke-dash: 3}
notification -> monitoring_svc.prometheus: "Send metrics\n[Prometheus endpoint]" {style.stroke: "#059669"; style.stroke-dash: 3}
api_gw -> monitoring_svc.prometheus: "Send gateway\nmetrics [Prometheus endpoint]" {style.stroke: "#059669"; style.stroke-dash: 3}

booking -> monitoring_svc.jaeger: "Send trace\n[Span data]" {style.stroke: "#059669"; style.stroke-dash: 3}
payment -> monitoring_svc.jaeger: "Send trace\n[Span data]" {style.stroke: "#059669"; style.stroke-dash: 3}
checkin -> monitoring_svc.jaeger: "Send trace\n[Span data]" {style.stroke: "#059669"; style.stroke-dash: 3}
passenger -> monitoring_svc.jaeger: "Send trace\n[Span data]" {style.stroke: "#059669"; style.stroke-dash: 3}