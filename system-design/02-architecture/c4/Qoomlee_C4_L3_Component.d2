  manifest_manager: ManifestManager {
    shape: rectangle
    style.fill: "#B91C1C"
    style.font-color: "#FFFFFF"
    style.border-radius: 4
    tooltip: "Manages flight manifests and passenger lists for gate operations"
  }

  circuit_breaker: Circuit Breaker {
    shape: rectangle
