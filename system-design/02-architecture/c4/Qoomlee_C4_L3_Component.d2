  style.fill: "#DBEAFE"
  style.stroke: "#2E6DA4"
  style.font-color: "#1A3557"
}

redis: Redis {
  shape: cylinder
  style.fill: "#FEF3C7"
  style.stroke: "#D97706"
  style.font-color: "#92540A"
}

omise_api: Omise API {
  shape: rectangle
  style.fill: "#6B7280"
  style.font-color: "#FFFFFF"
  style.border-radius: 6
  style.stroke: "#374151"
}

# ── Internal Service Connections ──────────────────────────────────────────────

api_gw -> booking.flight_search: "GET /flights/search"
api_gw -> booking.pnr_manager: "POST /bookings\nGET /bookings/:id\nPATCH /bookings/:id\nDELETE /bookings/:id"
api_gw -> payment.charge_handler: "POST /payments/charge"
api_gw -> payment.qr_handler: "POST /payments/promptpay"
api_gw -> payment.refund_handler: "POST /payments/refund"
api_gw -> checkin.checkin_handler: "POST /checkin\nGET /checkin/_details"
api_gw -> flight.flight_controller: "POST /flights\nGET /flights\nPUT /flights/:id/status"
api_gw -> identity.auth_handler: "POST /auth/login\nPOST /auth/logout\nPOST /auth/refresh"

booking.pnr_manager -> booking.state_machine: "Validate & execute\nstate transition"
booking.pnr_manager -> booking.seat_inventory: "Request seat lock\nor confirm seat"
booking.pnr_manager -> booking.fare_engine: "Calculate modification\nor cancellation fee"
booking.pnr_manager -> booking.booking_repo: "Persist booking\nstate change"
booking.pnr_manager -> booking.event_publisher: "Emit domain event\non state change"
booking.pnr_manager -> booking.circuit_breaker: "Apply circuit\nbreaker pattern"

booking.seat_inventory -> redis: "SET seat_lock:{flightId}:{seat}\nEX 480 (8-min TTL)"
booking.booking_repo -> pg: "INSERT/UPDATE/SELECT\nbookings, passengers,\nseat_inventory"
booking.event_publisher -> redis: "XADD booking_events\n[Redis Stream]"

checkin.checkin_handler -> checkin.boarding_pass_gen: "Generate boarding pass\nwith IATA BCBP format"
checkin.checkin_handler -> checkin.manifest_manager: "Update flight manifest\nwith checked-in passengers"
checkin.checkin_handler -> checkin.circuit_breaker: "Apply circuit\nbreaker pattern"
checkin.manifest_manager -> pg: "UPDATE flight_manifests\nfor gate operations"

flight.flight_controller -> flight.route_manager: "Validate route\nrequirements"
flight.flight_controller -> flight.aircraft_config: "Configure\naircraft seat map"
flight.flight_controller -> flight.circuit_breaker: "Apply circuit\nbreaker pattern"
flight.flight_controller -> pg: "INSERT/UPDATE/SELECT\nflights, routes, aircraft"

identity.auth_handler -> identity.rbac_manager: "Validate user\npermissions"
identity.auth_handler -> identity.audit_logger: "Log authentication\nattempt"
identity.auth_handler -> pg: "SELECT users, roles,\nsessions from staff table"

notification.email_sender -> notification.event_consumer: "Process email\nnotification events"
notification.sms_sender -> notification.event_consumer: "Process SMS\nnotification events"
notification.event_consumer -> redis: "XREAD notification_events\n[Redis Stream Consumer]"

payment.charge_handler -> payment.payment_repo: "Record transaction"
payment.charge_handler -> payment.circuit_breaker: "Apply circuit\nbreaker pattern"
payment.charge_handler -> payment.retry_mechanism: "Handle retries\nfor failed calls"
payment.charge_handler -> omise_api: "POST /charges\n[Omise REST API]"

payment.qr_handler -> payment.payment_repo: "Record pending transaction"
payment.qr_handler -> payment.circuit_breaker: "Apply circuit\nbreaker pattern"
payment.qr_handler -> omise_api: "POST /charges (source.type=promptpay)"

payment.webhook_handler -> payment.payment_repo: "Update transaction status"
payment.webhook_handler -> booking.pnr_manager: "Confirm booking\nPATCH /bookings/:id/confirm"
payment.webhook_handler -> payment.circuit_breaker: "Apply circuit\nbreaker pattern"

payment.refund_handler -> omise_api: "POST /charges/:id/refunds"
payment.refund_handler -> payment.payment_repo: "Record refund"
payment.refund_handler -> payment.circuit_breaker: "Apply circuit\nbreaker pattern"

payment.reconciler -> payment.payment_repo: "Aggregate daily transactions"
payment.payment_repo -> pg: "INSERT/UPDATE/SELECT\npayments, transactions, refunds"

# ── Passenger Service Connections ───────────────────────────────────────────────

api_gw -> passenger.passenger_controller: "POST /passengers\nGET /passengers/:id\nPUT /passengers/:id\nPOST /passengers/batch"
passenger.passenger_controller -> passenger.passenger_validator: "Validate\npassenger data"
passenger.passenger_controller -> passenger.special_req_handler: "Process special\nrequirements"
passenger.passenger_controller -> passenger.document_manager: "Handle\ntravel documents"
passenger.passenger_controller -> passenger.passenger_repo: "Persist passenger\ndata to database"
passenger.passenger_controller -> passenger.circuit_breaker: "Apply circuit\nbreaker pattern"
passenger.passenger_repo -> pg: "INSERT/UPDATE/SELECT\npassengers table"

booking -> passenger.passenger_controller: "Validate passenger\nbefore booking [REST]" {style.stroke: "#0369A1"}
checkin -> passenger.passenger_controller: "Retrieve passenger\ndata for check-in [REST]" {style.stroke: "#0369A1"}

# ── Infrastructure Connections ───────────────────────────────────────────────

booking -> secrets_svc.vault_agent: "Retrieve service\nsecrets [Vault API]" {style.stroke: "#7C3AED"; style.stroke-dash: 3}
payment -> secrets_svc.vault_agent: "Retrieve payment\nAPI keys [Vault API]" {style.stroke: "#7C3AED"; style.stroke-dash: 3}
